{
  "name": "shizang",
  "productName": "拾藏",
  "version": "0.1.1",
  "private": true,
  "description": "收藏与点赞的个人资料库",
  "author": "Wind",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "engines": { "node": ">=24.22.0 <25" },
  "scripts": {
    "check:environment": "node scripts/check-environment.mjs",
    "prebuild": "npm run check:environment",
    "pretest": "npm run check:environment",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "server": "node dist/server/entry.cjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:collector": "node scripts/test-collector.mjs",
    "package:mac": "npm run build && node scripts/package-desktop.mjs mac",
    "package:win": "npm run build && node scripts/package-desktop.mjs win",
    "setup:shared": "node scripts/setup-shared.mjs",
    "restore:library": "node dist/server/recovery-cli.cjs",
    "release:check": "node scripts/check-release.mjs",
    "release:source": "node scripts/source-release.mjs",
    "mobile:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.61.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.wind.shizang",
    "productName": "拾藏",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**",
      "LICENSE",
      "package.json"
    ],
    "extraResources": [{ "from": "dist/legal", "to": "legal" }],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "identity": "-",
      "artifactName": "Shizang-${version}-macOS-${arch}.${ext}",
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "artifactName": "Shizang-${version}-Windows-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
